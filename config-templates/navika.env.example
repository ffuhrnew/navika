# Kopieren nach /etc/navika.env und an das eigene Setup anpassen
NOTIFY_DEST_HASH=""
STATUS_DEST_HASH=""
DEPLOY_HOST_IP="<DEPLOY_HOST_IP>"
DEPLOY_USER="pi"
DEPLOY_REPO_PATH="~/build/navika"
RNS_USER="pi"
TARGET_NETWORKS=("WLAN_SSID_1" "WLAN_SSID_2")

# Identity-Hashes (je 32 Hex-Zeichen, durch Leerzeichen getrennt), je Dienst. Jedes Programm hat auf dem
# Client eine eigene Identity (rnsh -p, rncp -p, rnx -p). LEER = dieser Listener startet nicht (Absicht).
ALLOWED_IDENTITIES_RNSH=""
ALLOWED_IDENTITIES_RNCP=""
ALLOWED_IDENTITIES_RNX=""

# Zielordner fuer empfangene rncp-Dateien (Standard: ~/rncp-inbox)
#RNCP_SAVE_PATH="/home/pi/rncp-inbox"

# Zeitsynchronisation per Samaya (optional). "yes" installiert samaya und den Timer beim Setup.
# Der oeffentliche Schluessel des Zeitservers (128 Hex-Zeichen) steht nur hier, nie im Repo.
SAMAYA_ENABLE="no"
SAMAYA_TIME_SERVER_KEY=""
#SAMAYA_REF="v0.1.0"

# Anzeigename in NomadNet. Leer = <Hostname>_OP.
NOMADNET_DISPLAY_NAME=""

# NomadNet-Node (optional). Ohne Angabe fragt das Setup.
#NOMADNET_NODE="yes"
#NOMADNET_NODE_NAME=""                  # Standard: <HOSTNAME>-NODE
#NOMADNET_STATUS_PAGE="yes"             # Start- und Statusseite bauen
#NOMADNET_STATUS_ALLOWED_FILE=""        # Datei mit Zeilen "hash,name" fuer die Allow-Liste
#NOMADNET_OPERATOR_LXMF=""              # LXMF-Adresse des Operators auf der Startseite

# Reticulum-TCP-Server (Port 4242, alle Interfaces). Standard: aus.
TCP_SERVER="no"
