# Kopieren nach /etc/navika.env und an das eigene Setup anpassen
NOTIFY_DEST_HASH=""
STATUS_DEST_HASH=""
DEPLOY_HOST_IP="<DEPLOY_HOST_IP>"
DEPLOY_USER="pi"
DEPLOY_REPO_PATH="~/build/navika"
RNS_USER="pi"
TARGET_NETWORKS=("WLAN_SSID_1" "WLAN_SSID_2")

# Identity-Hashes (je 32 Hex-Zeichen, durch Leerzeichen getrennt), die rnsh/rncp/rnx
# auf diesem Node nutzen duerfen. LEER = Listener starten nicht (Absicht).
ALLOWED_IDENTITIES=""

# Reticulum-TCP-Server (Port 4242, alle Interfaces). Standard: aus.
TCP_SERVER="no"
